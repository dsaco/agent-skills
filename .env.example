# 环境变量配置模板：仅在本地 .env 或系统环境变量中填写真实值。
# 已有 .env 时逐项补充，不要用本模板覆盖；真实 .env 已被 Git 忽略。
# 仅配置需要的服务，空值表示未配置；不使用的条目可以删除。
# 自维护脚本不会自动读取 .env，需由本地启动流程注入所需变量。
# 若已在系统环境变量中配置，无需再填一份；Windows 更新后需重启终端／Agent。
# 配置密钥不等于服务已开通，模型／项目权限仍需在对应平台确认。

# ── 自维护技能 ──

# fal-ai：图片生成、编辑、去背景、深度／姿态提取及任务恢复。
FAL_KEY=

# volcengine-ark-media / 火山方舟：Seedream 图片、Seedance 视频。
# 从火山方舟控制台获取；与下方豆包语音凭据分别配置。
ARK_API_KEY=

# volcengine-ark-media / 豆包语音：录音文件识别 2.0、文字与字幕导出。
# 新版语音控制台 API Key；需有 volc.seedasr.auc 服务权限。
# 当前脚本已接入录音转写，尚未接入豆包语音合成或声音复刻。
VOLCENGINE_SPEECH_API_KEY=

# 旧版语音控制台替代方案：仅没有新版 Key 时使用，下面两项必须同时配置。
# 新版 VOLCENGINE_SPEECH_API_KEY 非空时优先使用，不回退旧版凭据。
# VOLCENGINE_SPEECH_APP_ID=
# VOLCENGINE_SPEECH_ACCESS_TOKEN=

# dashscope-tts / 阿里云百炼：CosyVoice、Qwen-TTS 等语音合成。
DASHSCOPE_API_KEY=

# qiniu / 七牛云：对象存储上传，四项必须同时配置。
# QINIU_DOMAIN 填已配置的 HTTPS 访问域名，例如 https://cdn.example.com。
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=

# exe-dev 使用 SSH 认证，不需要在这里填写 API Key。

# ── 第三方技能 ──

# ElevenLabs：music、sound-effects、text-to-speech 共用。
ELEVENLABS_API_KEY=

# 小云雀：xyq-skill、xyq-short-drama-skill、xyq-marketing-skill 共用 CLI 登录态。
# 通常执行 pippit-tool-cli login 完成浏览器授权，无需填写环境变量。
# 仅自动化环境需要显式覆盖时启用；非空值优先于网页登录，无效时不会自动回退。
# XYQ_ACCESS_KEY=

# 其他第三方技能按各自的 SKILL.md 配置，安装入口见 README.md。
