# 默认忽略根目录的本地状态，仅放行源码与维护文件。
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/AGENTS.md
!/package.json
!/package-lock.json
!/docs/
!/tests/
!/scripts/
!/.github/
!/skills/

# skills 默认不入库；browser-skill 等第三方安装副本由此规则覆盖。
# 每次收录自维护技能时，明确添加目录白名单。
/skills/*
!/skills/fal-ai/
!/skills/volcengine-ark-media/
!/skills/dashscope-tts/
!/skills/qiniu/
!/skills/exe-dev/

# 凭据与机器配置：即使位于已放行目录也不得入库。
.env
.env.*
!/.env.example
*.env
*.pem
*.key
.npmrc
.workspace.env
.skill-lock.json
skills-lock.json

# 依赖、缓存与运行产物。
node_modules/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
.pi-subagents/
.playwright-cli/
# BrowserSkill 本地 BSK_HOME：daemon 状态、配置、调试与审计记录。
.bsk/
output/
outputs/
fal-output/
coverage/
artifacts/
dist/
*.log

# 真实任务输入、响应与临时文件。
request.json
status.json
result.json
downloads.json
cancel.json
create.json
*.submission.json
*.price.json
*.part
*.tmp
